{
  "name": "jizhi-react",
  "version": "2.5.3",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.0.2",
  "scripts": {
    "dev": "vite --config vite.dev.config.js",
    "build": "node scripts/build-all.js",
    "build:dev": "node scripts/build-dev.js",
    "build:chrome": "cross-env TARGET_BROWSER=chrome vite build && node scripts/build-chrome-tip.js",
    "build:chrome:zip": "node scripts/build-chrome.js",
    "build:firefox": "cross-env TARGET_BROWSER=firefox vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint --cache --format codeframe --ext .mjs,.jsx,.js src",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --list-different --write  \"**/*.{js,jsx}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "archiver": "^3.1.1",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "evergreen-ui": "7.1.9",
    "handlebars": "^4.7.6",
    "lodash": "^4.17.21",
    "prop-types": "^15",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.2.0",
    "react-icons": "^5.4.0",
    "retina-dom-to-image": "^2.5.6",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.0.0",
    "eslint": "^7.18.0",
    "eslint-config-prettier": "^7.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^3.3.0",
    "eslint-plugin-react": "^7.22.0",
    "jsdom": "^26.1.0",
    "prettier": "^2.2.1",
    "rimraf": "^3.0.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-web-extension": "^4.4.5",
    "vitest": "^3.2.4"
  }
}
