{
  "name": "几枝",
  "version": "2.5.4",
  "description": "支持自定义新标签页的扩展，几枝将在新标签页上展示中国传统色的层叠波浪动画效果搭配经典诗词。",
  "permissions": [],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jizhi@example.com"
    }
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "manifest_version": 2,
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
